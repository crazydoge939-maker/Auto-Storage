-- ============================================================
-- Helpers
-- ============================================================

-- Find the first available Tool with the given name (checks backpack, then equipped)
local function findToolByName(name)
	if not name or name == "" then return nil end
	local character = player.Character
	local backpack = player:FindFirstChild("Backpack")

	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") and child.Name == name then
				return child
			end
		end
	end

	if character then
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and child.Name == name then
				return child
			end
		end
	end

	return nil
end

-- Get the currently held tool (equipped in character)
local function getHeldTool()
	local character = player.Character
	if not character then return nil end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			return child
		end
	end
	return nil
end

-- Equip a tool from backpack into the character's hands
local function equipTool(tool)
	local character = player.Character
	if not character then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and tool.Parent ~= character then
		humanoid:EquipTool(tool)
	end
	return true
end

-- Store the held tool by sending the request directly to the server.
-- The script is fully standalone: no BindableEvent, no connection to ToolStorageLocal.
local function storeToSlot(slotIndex)
	local held = getHeldTool()
	if not held then return false end
	if not toolRemote then return false end
	toolRemote:FireServer("store", { tool = held, slot = slotIndex })
	return true
end

-- Highlight an entry while it is being processed
local function setHighlight(i, on)
	local entry = entries[i]
	if entry and entry.frame then
		entry.frame.BackgroundColor3 = on and COL_GREEN or COL_ENTRY
	end
end

-- ============================================================
-- Auto-store process
-- ============================================================

local autoActive = false

local function runAutoProcess()
	while autoActive do
		local didSomething = false

		for i = 1, 40 do
			if not autoActive then break end

			local toolName = entries[i].toolName
			if toolName and toolName ~= "" then
				-- Keep storing ALL tools with this name until none are left
				local storedCount = 0
				while autoActive do
					local tool = findToolByName(toolName)
					if not tool then break end

					setHighlight(i, true)
					statusLabel.Text = "Slot " .. i .. ": " .. toolName .. " (" .. (storedCount + 1) .. ")"

					-- Equip the tool if it is in the backpack
					local character = player.Character
					local backpack = player:FindFirstChild("Backpack")
					if character and backpack and tool.Parent == backpack then
						equipTool(tool)
						task.wait(0.3)
					end

					-- Store it into the TrollMenu slot
					if storeToSlot(i) then
						-- Wait for the server to process and remove the tool
						local maxWait = 2.0
						local waited = 0.0
						while waited < maxWait and autoActive do
							local stillHeld = false
							if character then
								for _, child in ipairs(character:GetChildren()) do
									if child == tool then
										stillHeld = true
										break
									end
								end
							end
							if not stillHeld then break end
							task.wait(0.1)
							waited += 0.1
						end
						storedCount += 1
						didSomething = true
					else
						break
					end

					task.wait(0.15)
				end

				setHighlight(i, false)

				if storedCount > 0 then
					statusLabel.Text = "Slot " .. i .. ": stored " .. storedCount .. "x " .. toolName
					task.wait(0.3)
				end
			end
		end

		if not autoActive then break end

		if not didSomething then
			statusLabel.Text = "Waiting for tools..."
			task.wait(1)
		else
			statusLabel.Text = "Cycle complete"
			task.wait(0.5)
		end
	end

	statusLabel.Text = ""
end

autoBtn.MouseButton1Click:Connect(function()
	autoActive = not autoActive
	if autoActive then
		autoBtn.BackgroundColor3 = COL_GREEN
		autoBtn.Text = "Auto: ON"
		task.spawn(runAutoProcess)
	else
		autoBtn.BackgroundColor3 = COL_RED
		autoBtn.Text = "Auto: OFF"
	end
end)
