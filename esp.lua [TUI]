
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remote = ReplicatedStorage:FindFirstChild("ToolRestorationEvent")

-- Хранилище: playerId -> { [slotIndex] = { name = string, tools = {Tool1, Tool2, ...} } }
local storage = {}
local NUM_SLOTS = 40

local function getStorage(player)
    if not storage[player.UserId] then
        storage[player.UserId] = {}
    end
    return storage[player.UserId]
end

local function sendUpdate(player)
    local s = getStorage(player)
    local list = {}
    for i = 1, NUM_SLOTS do
        local slot = s[i]
        if slot and #slot.tools > 0 then
            list[i] = { name = slot.name, count = #slot.tools }
        else
            list[i] = { name = "", count = 0 }
        end
    end
    remote:FireClient(player, "update", list)
end

local function onPlayerAdded(player)
    storage[player.UserId] = {}

    remote.OnServerEvent:Connect(function(plr, action, data)
        if plr ~= player then return end

        local s = getStorage(player)

        if action == "requestList" then
            sendUpdate(player)

        elseif action == "store" then
            -- data = { tool = ToolInstance, slot = number }
            if type(data) ~= "table" then return end
            local tool = data.tool
            local slotIndex = data.slot
            if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then return end
            if tool.Parent ~= player.Character then return end
            if type(slotIndex) ~= "number" or slotIndex < 1 or slotIndex > NUM_SLOTS then return end

            local slot = s[slotIndex]
            if not slot then
                -- Пустой слот — создаём новый стек
                slot = { name = tool.Name, tools = {} }
                s[slotIndex] = slot
            elseif slot.name ~= tool.Name then
                -- В слоте лежит другой инструмент — не позволяем смешивать
                return
            end

            -- Добавляем инструмент в стек
            tool.Parent = nil
            table.insert(slot.tools, tool)
            sendUpdate(player)

        elseif action == "retrieve" then
            -- data = slot index (number)
            local slotIndex = data
            if type(slotIndex) ~= "number" or slotIndex < 1 or slotIndex > NUM_SLOTS then return end

            -- Проверяем, что игрок не держит Tool
            local character = player.Character
            if not character then return end
            local holding = false
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("Tool") then
                    holding = true
                    break
                end
            end
            if holding then return end

            local slot = s[slotIndex]
            if slot and #slot.tools > 0 then
                local tool = table.remove(slot.tools, #slot.tools)
                if tool and tool.Parent == nil then
                    tool.Parent = character
                    sendUpdate(player)
                end
            end
        end
    end)

    -- Очистка при выходе игрока
    player.AncestryChanged:Connect(function(_, newParent)
        if not newParent then
            local s = storage[player.UserId]
            if s then
                for _, slot in pairs(s) do
                    if slot and slot.tools then
                        for _, tool in ipairs(slot.tools) do
                            if tool and tool.Parent == nil then
                                tool:Destroy()
                            end
                        end
                    end
                end
            end
            storage[player.UserId] = nil
        end
    end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
    onPlayerAdded(p)
end
